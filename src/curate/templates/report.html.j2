<!doctype html><html><head><meta charset="utf-8">
<title>Curation report — {{ c.name }}</title>
<style>
body{font-family:-apple-system,Segoe UI,Roboto,sans-serif;max-width:1040px;margin:2rem auto;padding:0 1rem;color:#111}
h1{margin-bottom:.2rem} .muted{color:#666} table{border-collapse:collapse;margin:.5rem 0 1.2rem;font-size:.9rem}
td,th{border:1px solid #ddd;padding:.3rem .6rem;text-align:left;vertical-align:top} th{background:#f6f6f6}
.kpis{display:flex;gap:1rem;margin:1rem 0}.kpi{border:1px solid #e5e5e5;border-radius:8px;padding:.6rem 1rem}
.kpi b{display:block;font-size:1.5rem} img{max-width:100%} .grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
pre{white-space:pre-wrap;background:#fafafa;border:1px solid #eee;padding:.4rem;font-size:.8rem;margin:0}
</style></head><body>
<h1>Curation report — {{ c.name }}</h1>
<p class="muted">Generated by <code>curate run</code>. Stage order: {{ c.funnel|map(attribute='stage')|join(' → ') }}</p>
<div class="kpis">
 <div class="kpi">Input<b>{{ "{:,}".format(c.n_in) }}</b></div>
 <div class="kpi">Kept<b>{{ "{:,}".format(c.n_out) }}</b></div>
 <div class="kpi">Retention<b>{{ "%.1f"|format(c.retention*100) }}%</b></div>
 <div class="kpi">Docs with PII redacted<b>{{ c.pii.get('docs_with_pii', 0) }}</b></div>
</div>
<h2>Funnel</h2><img src="data:image/png;base64,{{ charts.funnel }}">
<table><tr><th>stage</th><th>rows in</th><th>removed</th><th>rows out</th></tr>
{% for f in c.funnel %}<tr><td>{{ f.stage }}</td><td>{{ f.rows_in }}</td><td>{{ f.removed }}</td><td>{{ f.rows_out }}</td></tr>{% endfor %}</table>
<h3>Removals by rule</h3><table><tr><th>stage</th><th>rule</th><th>removed</th></tr>
{% for r in c.reasons %}<tr><td>{{ r.stage }}</td><td>{{ r.rule }}</td><td>{{ r.removed }}</td></tr>{% endfor %}</table>
<h2>Length distribution</h2><img src="data:image/png;base64,{{ charts.lengths }}">
<table><tr>{% for k in c.lengths[0].keys() %}<th>{{ k }}</th>{% endfor %}</tr>
{% for r in c.lengths %}<tr>{% for v in r.values() %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}</table>
<div class="grid">
<div><h2>Near-duplicate clusters</h2>{% if charts.clusters %}<img src="data:image/png;base64,{{ charts.clusters }}">{% else %}<p>No clusters.</p>{% endif %}</div>
<div><h2>PII</h2>{% if charts.pii %}<img src="data:image/png;base64,{{ charts.pii }}">{% endif %}
<p>Hit rate: {{ "%.2f"|format((c.pii.get('hit_rate') or 0)*100) }}% of records · action: {{ c.pii.get('action') }}</p></div>
</div>
{% for cl in c.clusters %}<h4>Cluster {{ cl.id }}</h4><table><tr><th>id</th><th>rep?</th><th>Ĵ</th><th>text</th></tr>
{% for m in cl.members %}<tr><td>{{ m.id }}</td><td>{{ '✓' if m.is_representative else '' }}</td><td>{{ '%.2f'|format(m.est_jaccard_to_rep) if m.est_jaccard_to_rep is not none else '' }}</td><td><pre>{{ m.text_preview }}</pre></td></tr>{% endfor %}</table>{% endfor %}
<h2>Samples of removed records</h2>
{% for ex in c.examples %}<h3>{{ ex.stage }}</h3><table><tr><th>id</th><th>reason</th><th>text (truncated)</th></tr>
{% for it in ex['items'] %}<tr><td>{{ it.id }}</td><td>{{ it.reason }}</td><td><pre>{{ it.text }}</pre></td></tr>{% endfor %}</table>{% endfor %}
<h2>Stage stats</h2><pre>{{ c.stage_stats|tojson(indent=2) }}</pre>
</body></html>
